# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Prefer a model your free tier still has quota for (see https://ai.google.dev/gemini-api/docs/rate-limits)
# Examples: gemini-1.5-flash, gemini-1.5-flash-8b, gemini-2.0-flash-lite
GEMINI_MODEL=gemini-1.5-flash

# Optional fallback when Gemini rate-limits or fails
GROQ_API_KEY=your_groq_api_key_here
# See https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

